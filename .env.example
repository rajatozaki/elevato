# Alevate Website Environment Variables
# Copy this file to .env.local or add them in your Vercel Project Settings > Environment Variables

# Site URL
NEXT_PUBLIC_SITE_URL=https://alevate.in

# -------------------------------------------------------------
# Contact Form Instant Notification Channels (Configure any!)
# -------------------------------------------------------------

# Option 1: Discord Webhook (Free, instant push to private channel)
# Create a Discord webhook in your server: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Option 2: Telegram Bot (Free, instant push to Telegram chat)
# Create bot with @BotFather, get chat ID with @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option 3: Slack Incoming Webhook
SLACK_WEBHOOK_URL=

# Option 4: Resend Email Notification (https://resend.com)
RESEND_API_KEY=
CONTACT_EMAIL_TO=hello@alevate.in

# Option 5: Generic Webhook URL (Zapier, Make, n8n, etc.)
NOTIFICATION_WEBHOOK_URL=
